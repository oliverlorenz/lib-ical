{
  "name": "@oliverlorenz/lib-ical",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "del-cli ./dist",
    "lint": "npm run lint:eslint && npm run lint:prettier && npm run lint:types",
    "lint:eslint": "eslint ./src --ext .ts",
    "lint:prettier": "prettier \"src/**/*.ts\" --cache --check",
    "lint:types": "tsc --noEmit --skipLibCheck && tsc-strict",
    "test": "npm run build && jest --coverage",
    "test:watch": "jest --coverage --coverage-reporters html --watch-all",
    "postinstall": "npx husky init",
    "prepare": "husky",
    "git-hook:pre-commit": "npm test",
    "git-hook:pre-push": "npm run lint:eslint && npm run lint:prettier && npm test",
    "check:all": "npm run git-hook:pre-push && npm run git-hook:pre-commit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oliverlorenz/lib-ical.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/oliverlorenz/lib-ical/issues"
  },
  "homepage": "https://github.com/oliverlorenz/lib-ical#readme",
  "description": "",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "^9.33.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "del-cli": "^6.0.0",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-import": "^2.31.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "prettier": "^3.5.2",
    "ts-jest": "^29.4.1",
    "typescript": "^5.9.2",
    "typescript-strict-plugin": "^2.4.4"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
